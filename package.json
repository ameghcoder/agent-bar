{
  "name": "agentbar",
  "version": "0.2.0",
  "private": true,
  "description": "GNOME top-bar companion for Claude Code",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.0",
  "bin": {
    "agentbar": "dist/src/cli/index.js",
    "agentbar-hook": "dist/agents/claude-code/hooks/claude-hook.js"
  },
  "scripts": {
    "build": "tsc && node os/linux/scripts/copy-extension-lib.mjs",
    "typecheck": "tsc --noEmit",
    "agentbar": "node dist/src/cli/index.js",
    "agentbar-hook": "node dist/agents/claude-code/hooks/claude-hook.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "package:deb": "node os/linux/packaging/deb/build.mjs dist/package"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "~5.9.3"
  }
}
