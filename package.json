{
  "name": "agentbar",
  "version": "0.1.0",
  "private": true,
  "description": "Local Claude Code hook capture for a future GNOME companion",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.0",
  "bin": {
    "agentbar": "dist/cli/index.js",
    "agentbar-hook": "dist/hooks/claude-hook.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "agentbar": "node dist/cli/index.js",
    "agentbar-hook": "node dist/hooks/claude-hook.js",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "~5.9.3"
  }
}
