            "type": "command",
            "command": "node /absolute/path/to/agentbar/dist/hooks/claude-hook.js --event pre_tool_use",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/agentbar/dist/hooks/claude-hook.js --event post_tool_use",
